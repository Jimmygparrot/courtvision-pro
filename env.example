# Local PostgreSQL settings for CourtVision Pro (Supabase session pooler).
# Copy the values into your Windows user environment variables or a private,
# git-ignored file. Never commit real values.
COURTVISION_DB_HOST=<session-pooler-host>
COURTVISION_DB_PORT=5432
COURTVISION_DB_NAME=postgres
COURTVISION_DB_USER=courtvision_app.<project-ref>
COURTVISION_DB_PASSWORD=<set-in-your-environment-only>
# Path to the Supabase CA certificate (Dashboard > Database > SSL Configuration)
COURTVISION_DB_SSLROOTCERT=<path-to-supabase-ca.crt>
